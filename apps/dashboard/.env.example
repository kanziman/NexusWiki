# NexusWiki dashboard 환경 변수 (06-01-PLAN.md Task 1)
#
# 값은 apps/api의 SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY와 동일해야 한다
# (packages/core/src/nexuswiki_core/settings.py). 여기 담기는 키는 BOOT-02의
# `sb_publishable_` 접두 키(브라우저에 노출돼도 안전한 publishable/anon-equivalent
# 키)이며, `sb_secret_` 접두 secret 키를 여기 넣으면 안 된다 — NEXT_PUBLIC_ 접두사가
# 붙은 값은 클라이언트 번들에 그대로 노출된다.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# apps/api 기본 URL (로컬 기본값)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
