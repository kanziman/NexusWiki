# =============================================================================
# NexusWiki Environment Variables (.env.sample)
#
# 복사하여 .env 또는 .env.local 로 저장 후 실제 값을 채워주세요.
# cp .env.sample .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Supabase Cloud / Local Project Settings
# -----------------------------------------------------------------------------
# Supabase 대시보드 (Project Settings -> API)에서 확인한 URL 및 신규 키 포맷
# (주의: 2025년 11월 이후 생성된 프로젝트는 sb_publishable_ / sb_secret_ 키 사용)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_service_key_here

# -----------------------------------------------------------------------------
# 2. Database Connection (Postgres / asyncpg / Supavisor)
# -----------------------------------------------------------------------------
# asyncpg 및 5-Way 검색 세션 옵션(hnsw.iterative_scan) 적용을 위한 연결 문자열
# Supavisor Session Mode (Port 5432 사용 권장)
DATABASE_URL=postgresql://postgres:your_db_password_here@db.your-project-id.supabase.co:5432/postgres

# 로컬 개발 스택 (Supabase CLI local dev 사용 시)

# -----------------------------------------------------------------------------
# 3. LLM & Embedding API Keys — OPENROUTER_API_KEY 하나가 둘을 모두 덮는다 (03-CONTEXT.md > D-04)
# -----------------------------------------------------------------------------
# OpenRouter API Key (위키 컴파일 · Q&A 생성 · 임베딩 — 키 하나가 셋을 모두 덮습니다)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_MODEL=anthropic/claude-sonnet-4.6

# 임베딩 (03-CONTEXT.md > D-04, D-05)
# 공급자를 고정하고 폴백을 금지합니다. 같은 모델명이어도 호스트마다 정규화·풀링이 달라
# 벡터가 미묘하게 달라지는데, 섞인 벡터는 재임베딩 외에 복구 수단이 없습니다.
# EMBEDDING_PROVIDER 값은 OpenRouter의 provider.order 원소(호스팅 업체 슬러그)입니다.
#
# 두 값은 실제 응답으로 확인했습니다 (2026-08-08).
# 관측 기록: docs/ops/openrouter-contract-record.md
# ⚠️ EMBEDDING_PROVIDER는 요청에 싣는 routing 슬러그(provider.order 원소)이고,
#    응답의 provider 필드는 표시명 "DeepInfra"입니다 — 두 문자열은 같지 않습니다.
#    /fp32 접미가 양자화까지 고정합니다. 이것을 빼면 같은 호스트가 fp16으로 서빙할 때
#    벡터가 미묘하게 달라질 수 있고, 섞인 벡터는 재임베딩 외에 복구 수단이 없습니다.
EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_PROVIDER=deepinfra/fp32


# YouTube Data API v3 Key (채널 검색 · 영상 목록)
# ⚠️ Google Cloud Console에서 키를 만든 뒤 **YouTube Data API v3를 활성화**해야 합니다.
#    키만 발급하고 API를 켜지 않으면 403이 돌아오고, 화면에는 "연결하지 못했습니다"만 뜹니다.
# ⚠️ 이 키는 **worker 서비스에만** 주입합니다. api 서비스에 넣지 마세요 — `ApiSettings`에는
#    provider 자격증명을 담을 필드가 없고(SEC-01), 그 부재가 유일한 격리 수단입니다.
YOUTUBE_API_KEY=your-youtube-data-api-v3-key-here

# -----------------------------------------------------------------------------
# 4. Worker ↔ API 내부 경계 (provider 키를 api로 옮기지 않기 위한 프록시 배선)
# -----------------------------------------------------------------------------
# provider 키는 worker만 소유하고, api는 내부 호출자 토큰으로 worker의 사설 리스너를
# 호출하기만 합니다. 아래 `*_TOKEN`은 provider 자격증명이 아니라 **내부 호출자 자격**입니다.
#
# ⚠️ 배포 시 반드시 함께 설정해야 합니다. 하나라도 비면 worker가 해당 라우트를 **등록조차
#    하지 않고**(설정 누락이 업스트림 장애로 위장되는 것을 막기 위한 의도된 동작), api는
#    그 호출을 "일시적 장애"로 표시합니다 — 기능이 조용히 죽은 것처럼 보입니다.
#    실제로 2026-09-10에 이 네 변수 미설정으로 YouTube 검색이 배포 후 동작하지 않았습니다.
# ⚠️ 세 리스너는 worker의 **같은 앱·같은 포트(8081)**에 올라갑니다. URL 값은 셋이 동일하고,
#    토큰만 캐퍼빌리티별로 다른 값을 씁니다.
# ⚠️ 각 `_TOKEN`은 worker와 api **양쪽에 같은 값**이 들어가야 합니다. 값이 다르면 401입니다.

# worker 서비스에만 주입 (토큰 소유자)
QUERY_EMBEDDING_INTERNAL_TOKEN=generate-a-random-token-for-embedding-here
LLM_STREAM_INTERNAL_TOKEN=generate-a-different-random-token-for-llm-here
YOUTUBE_SEARCH_INTERNAL_TOKEN=generate-a-different-random-token-for-youtube-here

# api 서비스에만 주입 (호출자) — URL은 worker의 사설 네트워크 주소입니다
QUERY_EMBEDDING_INTERNAL_URL=http://worker.railway.internal:8081
LLM_STREAM_INTERNAL_URL=http://worker.railway.internal:8081
YOUTUBE_SEARCH_INTERNAL_URL=http://worker.railway.internal:8081


# -----------------------------------------------------------------------------
# 5. Application & Server Configuration
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
SECRET_KEY=generate-a-random-secret-key-for-jwt-signing-here

# -----------------------------------------------------------------------------
# 6. Frontend (Next.js 15) Environment Variables
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
